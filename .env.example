# Environment variables for DocsBox

# API
API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-in-production

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database (optional - for cloud sync)
DATABASE_URL=postgresql://user:password@localhost:5432/docsbox

# Storage (optional - for cloud sync)
S3_BUCKET=docsbox-files
S3_REGION=eu-west-3
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Analytics (optional)
POSTHOG_KEY=your-posthog-key
SENTRY_DSN=your-sentry-dsn

# IAP (production only)
APPLE_SHARED_SECRET=your-apple-secret
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
