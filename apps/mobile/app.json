{
    "expo": {
        "name": "DocsBox",
        "slug": "docsbox",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "scheme": "docsbox",
        "userInterfaceStyle": "automatic",
        "splash": {
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#3B82F6"
        },
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.docsbox.app",
            "infoPlist": {
                "NSCameraUsageDescription": "DocsBox utilise la caméra pour scanner vos documents.",
                "NSPhotoLibraryUsageDescription": "DocsBox accède à vos photos pour importer des documents.",
                "NSFaceIDUsageDescription": "DocsBox utilise Face ID pour sécuriser l'accès à vos documents."
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#3B82F6"
            },
            "package": "com.docsbox.app",
            "permissions": [
                "android.permission.CAMERA",
                "android.permission.READ_EXTERNAL_STORAGE",
                "android.permission.USE_BIOMETRIC",
                "android.permission.USE_FINGERPRINT"
            ]
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-secure-store",
            [
                "expo-camera",
                {
                    "cameraPermission": "DocsBox utilise la caméra pour scanner vos documents."
                }
            ],
            [
                "expo-local-authentication",
                {
                    "faceIDPermission": "DocsBox utilise Face ID pour sécuriser l'accès."
                }
            ],
            [
                "expo-notifications",
                {
                    "icon": "./assets/notification-icon.png",
                    "color": "#3B82F6"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}